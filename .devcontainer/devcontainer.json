{
  // GitHub Codespaces / VS Code dev container: EVAC with demo data, SQLite and no Redis.
  // Open the forwarded port 8000 and log in as admin@evac.local / evac-demo-admin.
  "name": "EVAC",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "hostRequirements": {"cpus": 2},
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "bash .devcontainer/start.sh",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {"label": "EVAC", "onAutoForward": "openBrowser"}
  },
  "customizations": {
    "codespaces": {"openFiles": [".devcontainer/README.md"]},
    "vscode": {"extensions": ["ms-python.python", "charliermarsh.ruff"]}
  }
}
