# /etc/evac-kiosk.env - read by the EVAC kiosk (deploy/kiosk/provision.sh writes it)
# The player URL of your EVAC (the screen shows a pairing code there on first start).
EVAC_URL=https://evac.example.org/player/
# Extra Chromium flags, e.g. --force-device-scale-factor=1 or --enable-features=... for hardware decoding.
EVAC_EXTRA_FLAGS=
