# EVAC kiosk: Chromium on the player, full screen on the first display (cage on tty1).
[Unit]
Description=EVAC screen kiosk
After=systemd-user-sessions.service network-online.target
Wants=network-online.target
Conflicts=getty@tty1.service

[Service]
User=kiosk
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
Environment=XDG_RUNTIME_DIR=/run/user/%U
ExecStartPre=+/bin/sh -c 'mkdir -p /run/user/$(id -u kiosk) && chown kiosk: /run/user/$(id -u kiosk) && chmod 700 /run/user/$(id -u kiosk)'
ExecStart=/usr/local/lib/evac-kiosk/evac-kiosk.sh
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target
