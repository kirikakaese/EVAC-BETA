# Lines to set in /opt/evac/.env besides the values from evac-secrets.env.
# Replace evac.example.org with your domain.
DEBUG=0
EVAC_MODE=central
EVAC_PUBLIC_URL=https://evac.example.org
ALLOWED_HOSTS=evac.example.org
CSRF_TRUSTED_ORIGINS=https://evac.example.org
SESSION_COOKIE_SECURE=1
CSRF_COOKIE_SECURE=1
# Same origin: Caddy routes /ws/ to the channels service
EVAC_REALTIME_URL=
EVAC_SEED_DEMO=0
# Caddy sets X-Forwarded-Proto. The ports are bound to 127.0.0.1, so only Caddy can send it
FORWARDED_ALLOW_IPS=*
LOG_FORMAT=json
EMAIL_URL=consolemail://
DEFAULT_FROM_EMAIL=evac@example.org
