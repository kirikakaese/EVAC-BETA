# Lines to set in /opt/evac/.env besides the values from evac-secrets.env.
DEBUG=0
EVAC_MODE=central
EVAC_PUBLIC_URL=https://evac.pm
ALLOWED_HOSTS=evac.pm
CSRF_TRUSTED_ORIGINS=https://evac.pm
SESSION_COOKIE_SECURE=1
CSRF_COOKIE_SECURE=1
# Same origin: Caddy routes /ws/ to the channels service
EVAC_REALTIME_URL=
EVAC_SEED_DEMO=0
# Caddy sets X-Forwarded-Proto. The ports are bound to 127.0.0.1, so only Caddy can send it
FORWARDED_ALLOW_IPS=*
LOG_FORMAT=json
# Outgoing mail (invitations): consolemail:// only writes mails to the log. Use your SMTP account, e.g.
# smtp+tls://user:password@smtp.example.net:587
EMAIL_URL=consolemail://
DEFAULT_FROM_EMAIL=noreply@evac.pm
