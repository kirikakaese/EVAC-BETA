# Lines to set in /opt/dial/.env besides the values from dial-secrets.env.
DEBUG=0
DIAL_PUBLIC_URL=https://dial.pm
ALLOWED_HOSTS=dial.pm
CSRF_TRUSTED_ORIGINS=https://dial.pm
SESSION_COOKIE_SECURE=1
CSRF_COOKIE_SECURE=1
# IMPORTANT: the default (1) creates the demo event and admin@dial.local / admin
DIAL_SEED_DEMO=0
# No PBX on the central server: every event connects its own venue PBX (orga: "PBX & DECT connection")
DIAL_PBX_BACKEND=apps.pbx.backends.dummy.DummyPBX
DIAL_DECT_BACKEND=apps.dect.backends.dummy.DummyDECT
