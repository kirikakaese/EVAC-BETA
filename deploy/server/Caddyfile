# /etc/caddy/Caddyfile - replace evac.example.org / dial.example.org with your domains.
# Caddy obtains and renews the Let's Encrypt certificates on its own (ports 80 and 443 must be open).
{
	email admin@example.org
}

evac.example.org {
	encode zstd gzip
	# WebSockets (live updates, later the screens) go to the channels service
	reverse_proxy /ws/* 127.0.0.1:8101
	reverse_proxy 127.0.0.1:8100
	header Strict-Transport-Security "max-age=31536000"
}

dial.example.org {
	encode zstd gzip
	reverse_proxy 127.0.0.1:8200
	header Strict-Transport-Security "max-age=31536000"
}
