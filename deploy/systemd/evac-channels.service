# EVAC channels (WebSockets). Install: copy to /etc/systemd/system/, then: systemctl enable --now evac-channels
[Unit]
Description=EVAC channels (WebSockets)
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target
PartOf=evac.target

[Service]
Type=simple
User=evac
Group=evac
WorkingDirectory=/opt/evac
EnvironmentFile=/etc/evac/evac.env
Environment=DJANGO_SETTINGS_MODULE=evac.settings.prod
# ASGI workers sharing the port: one process cannot deliver an alarm to 1,000 screens in time (ADR-0047)
ExecStart=/opt/evac/.venv/bin/gunicorn evac.asgi:application -k uvicorn_worker.UvicornWorker --bind 127.0.0.1:8001 --workers 3 --timeout 90
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/evac

[Install]
WantedBy=evac.target
