# EVAC web (HTTP + SSE). Install: copy to /etc/systemd/system/, then: systemctl enable --now evac-web
[Unit]
Description=EVAC web (HTTP + SSE)
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target
PartOf=evac.target

[Service]
Type=simple
User=evac
Group=evac
WorkingDirectory=/opt/evac
EnvironmentFile=/etc/evac/evac.env
Environment=DJANGO_SETTINGS_MODULE=evac.settings.prod
ExecStart=/opt/evac/.venv/bin/gunicorn evac.asgi:application -k uvicorn_worker.UvicornWorker --bind 127.0.0.1:8000 --workers 3 --timeout 90
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/evac

[Install]
WantedBy=evac.target
