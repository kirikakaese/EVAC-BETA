{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EVAC Player",
  "version": "1.0.0",
  "identifier": "org.evac.player",
  "build": {
    "frontendDist": "../setup"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "msi", "dmg"],
    "category": "Utility",
    "shortDescription": "EVAC screen player",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico"]
  }
}
