# EVAC configuration. Copy to .env and adjust. Every value can also be set as an environment variable.

# --- core -------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me
DEBUG=0
ALLOWED_HOSTS=*
CSRF_TRUSTED_ORIGINS=http://localhost:8000
# Public base URL (used in invitation links and webhook URLs)
EVAC_PUBLIC_URL=http://localhost:8000
TIME_ZONE=UTC
# central = the permanent multi-event service; node = a venue node (see docs/adr/0002-central-node-sync.md)
EVAC_MODE=central

# Keys for secrets at rest (extension credentials, TOTP seeds). Comma separated, first one encrypts.
# Generate with: python manage.py evac_genkey   (rotate: prepend a new key, run evac_rotate_secrets)
EVAC_SECRETS_KEYS=

# Optional: require this token in the first-run wizard (recommended when the server is reachable by others
# before you finished the setup).
EVAC_SETUP_TOKEN=

# Early-access gate: a shared password in front of the whole site (incl. the first-run wizard) while the
# instance is not public yet. Empty = off. Changing it locks every browser out again. See ADR-0012.
EVAC_EARLY_ACCESS_PASSWORD=
EVAC_EARLY_ACCESS_DAYS=30
EVAC_EARLY_ACCESS_MESSAGE=

# Fill the database with the demo venue, event and accounts on start (container entrypoint).
EVAC_SEED_DEMO=0

# --- database / redis --------------------------------------------------------
DATABASE_URL=postgres://evac:evac@localhost:5432/evac
REDIS_URL=redis://localhost:6379/0
POSTGRES_USER=evac
POSTGRES_PASSWORD=evac
POSTGRES_DB=evac

# Browsers open WebSockets here. Empty = same origin (a reverse proxy routes /ws/ to the channels service).
# The compose demo has no proxy and sets http://localhost:8001. SSE and long-poll always use the same origin.
EVAC_REALTIME_URL=

# --- e-mail -------------------------------------------------------------------
EMAIL_URL=consolemail://
DEFAULT_FROM_EMAIL=evac@example.org
# Web Push contact for push services (mailto: or https:); empty = mailto:DEFAULT_FROM_EMAIL
EVAC_VAPID_SUBJECT=
# Offline speech (optional, ADR-0022): build with EVAC_WITH_TTS=1, voices via manage.py evac_tts install
EVAC_WITH_TTS=0
EVAC_PIPER_BINARY=piper
EVAC_TTS_VOICES_DIR=

# --- login --------------------------------------------------------------------
EVAC_LOGIN_MAX_FAILURES=5
EVAC_LOGIN_LOCKOUT_MINUTES=15
EVAC_INVITATION_TTL_HOURS=168

# OpenID Connect single sign-on (redirect URI: <EVAC_PUBLIC_URL>/accounts/oidc/callback/)
EVAC_OIDC_ENABLED=0
EVAC_OIDC_ISSUER=
EVAC_OIDC_CLIENT_ID=
EVAC_OIDC_CLIENT_SECRET=
EVAC_OIDC_SCOPES=openid email profile
EVAC_OIDC_BUTTON_LABEL=Log in with SSO
EVAC_OIDC_AUTO_CREATE=1
EVAC_OIDC_TRUST_EMAIL_VERIFIED=1
EVAC_OIDC_ALLOW_PASSWORD_LOGIN=1
# Accept an IdP login with MFA (amr claim) as two-factor verified in EVAC
EVAC_OIDC_TRUST_MFA=0

# WebAuthn relying party (empty = host of the request)
EVAC_WEBAUTHN_RP_ID=
EVAC_WEBAUTHN_RP_NAME=EVAC

# --- operations ---------------------------------------------------------------
LOG_LEVEL=INFO
# std | json (structured logs)
LOG_FORMAT=std
EVAC_WEBHOOK_TIMEOUT=5
# program imports (pretalx, frab, iCal) may reach private/venue-network addresses
EVAC_IMPORT_ALLOW_PRIVATE=0
EVAC_OUTBOX_MAX_ATTEMPTS=8
# Comma separated plugin apps to leave uninstalled (e.g. extensions.webhooks)
EVAC_DISABLED_PLUGINS=
# Optional error reporting (Sentry-compatible DSN; requires the sentry-sdk package)
SENTRY_DSN=
